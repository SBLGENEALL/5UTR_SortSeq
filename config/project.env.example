# Copy to a private location such as:
# /data/user/MCET03/03_NGS/02_5UTR_sorting/config/sortseq.env

PROJECT_DIR=/data/user/MCET03/03_NGS/02_5UTR_sorting
RAW_DIR=/data/user/MCET03/03_NGS/02_5UTR_sorting/raw_data
RESULTS_DIR=/data/user/MCET03/03_NGS/02_5UTR_sorting/results

# Generated by scripts/init_project.py, then reviewed manually.
SAMPLE_SHEET=/data/user/MCET03/03_NGS/02_5UTR_sorting/config/SampleSheet.csv
SAMPLE_MAP=/data/user/MCET03/03_NGS/02_5UTR_sorting/config/sample_map.csv

# Reuse the exact reference/primer/matching rules from the plasmid analysis.
LIBRARYQC_PY=/data/user/MCET03/03_NGS/01_5UTR_Plasmid/scripts/amplicon_qc_parallel.py
LIBRARYQC_CONFIG=/data/user/MCET03/03_NGS/01_5UTR_Plasmid/config/libraryqc.ini

PYTHON_BIN=python3
# 2 sockets x 64 physical cores. Hyperthreads are left for I/O/background work.
WORKERS=128
LIBRARYQC_BATCH_SIZE=10000

# Spread worker memory across the four NUMA nodes when numactl is available.
NUMA_INTERLEAVE=auto
NESTED_WORKER_THREADS=1

# Undetermined rescue: unique nearest expected i7+i5 pair only.
MAX_TOTAL_INDEX_MISMATCHES=2
MAX_PER_INDEX_MISMATCHES=2
MIN_INDEX_DISTANCE_MARGIN=1
I5_ORIENTATION=auto
PROGRESS_INTERVAL_SECONDS=30
PROGRESS_CHECK_READS=100000

# auto: pigz (if already installed) or built-in parallel Python gzip writers.
# No online installation is required on the offline analysis server.
RESCUE_COMPRESSION_BACKEND=auto
RESCUE_PIGZ_THREADS_PER_FILE=4

# Sort-seq analysis.
OVERALL_GATE_FRACTION=0.90
MIN_UNSORTED_COUNT=50
MIN_TOTAL_BIN_COUNT=100

# High-confidence candidate filter. Final cutoffs are the larger of the fixed
# floor and 10% of the experiment-wide median count.
STRICT_MIN_UNSORTED_COUNT=1000
STRICT_MIN_TOTAL_BIN_COUNT=5000
STRICT_RELATIVE_MEDIAN_FRACTION=0.10
STRICT_MIN_HIGH_BIN_COUNT=200
STRICT_MIN_DETECTED_BINS=3
JACKPOT_MAX_BIN_PROBABILITY=0.85
JACKPOT_MAX_DETECTED_BINS=2

# Reference/control UTR. auto recognizes both "original" and the common
# misspelling "orginal" without exporting any analysis data off the server.
REFERENCE_VARIANT_ID=auto
